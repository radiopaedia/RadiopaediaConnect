{
  "profiles": {
    "http": {
      "commandName": "Project",
      "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "http://localhost:5198"
    },
    "https": {
      "commandName": "Project",
      "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "https://localhost:7191;http://localhost:5198"
    },
    "Docker": {
      "commandName": "Docker",
      "launchBrowser": true,
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}",
      "environmentVariables": {
        "ASPNETCORE_HTTPS_PORTS": "7191",
        "ASPNETCORE_HTTP_PORTS": "5000"
      },
      "publishAllPorts": false,
      "useSSL": true,
      // MAP C:\data (Host) TO /data (Container)
      // Note the double backslash (\\) is required to escape the Windows path inside JSON.
      "DockerfileRunArguments": "-v \"C:\\data:/data\" -p 104:104"
    }
  },
  "$schema": "https://json.schemastore.org/launchsettings.json"
}